# Скопируйте в .env и заполните значения
# cp .env.example .env

# Обязательно: строка подключения к MySQL (формат mysql2)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Опционально (есть значения по умолчанию в lib/db.ts)
# DB_POOL_SIZE=5
# DB_CONNECT_TIMEOUT=30000

# Форма заявки: серверный (секретный) ключ SmartCaptcha.
# В клиентский бандл не попадает и попасть не должен — используется только в API-роуте.
YANDEX_SMARTCAPTCHA_SERVER_KEY=ysc2_...

# Клиентский (публичный) ключ SmartCaptcha. Виден в исходниках страницы — это нормально.
# Если не задан, используется значение по умолчанию в components/lead-form-body.tsx.
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY=ysc1_...

CONTACT_FORM_RECIPIENT_EMAIL=rinartburo@mail.ru

# SMTP для отправки заявок на почту
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=app-password
SMTP_FROM=user@example.com

# Telegram-уведомления о заявках.
# Без этих двух переменных канал молча отключён: заявка сохраняется и уходит на почту,
# но в Telegram не приходит. Именно так сейчас и было настроено на проде.
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather.
# TELEGRAM_CHAT_IDS — id чатов через запятую (личный чат, группа или канал с ботом внутри).
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_IDS=123456789,-1001234567890
