# Скопируйте в .env и заполните значения
# cp .env.example .env

# Обязательно: строка подключения к MySQL (формат mysql2)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Опционально (есть значения по умолчанию в lib/db.ts)
# DB_POOL_SIZE=5
# DB_CONNECT_TIMEOUT=30000

# Форма заявки
YANDEX_SMARTCAPTCHA_SERVER_KEY=ysc2_...
