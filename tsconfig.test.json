{
  "//": "Отдельная конфигурация для тестов: основной tsconfig собран под Next и ничего не эмитит. Здесь чистые модули компилируются в CommonJS, и их запускает встроенный в Node тест-раннер — без дополнительных зависимостей.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "allowJs": true,
    "incremental": false,
    "rootDir": ".",
    "outDir": ".test-build",
    "types": ["node"]
  },
  "include": [
    "lib/legal.ts",
    "lib/cookie-consent.ts",
    "lib/lead-validation.ts",
    "lib/lead-message.ts",
    "lib/lead-source.ts",
    "lib/lead-stats.ts",
    "lib/lead-storage.ts",
    "lib/pricing-tiers.ts",
    "app/lp/proekt-doma/quiz-steps.ts",
    "legacy-redirects.cjs",
    "lib/inline-images.cjs",
    "lib/seo/text.ts",
    "lib/articles.ts",
    "lib/article-lead-modal.ts",
    "lib/services.ts",
    "lib/seo/robots.ts",
    "lib/seo/schema.ts",
    "lib/seo/static-pages.ts",
    "types/project.ts",
    "tests/**/*.ts"
  ]
}
